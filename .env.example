# ── Runtime ──────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
TRUST_PROXY=false

# ── MongoDB ─────────────────────────────────────────
# Required in production. Use Atlas SRV string:
#   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/auto-present?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/auto-present

# ── CORS ────────────────────────────────────────────
# Comma-separated origins allowed to access the API.
# Production example: https://app.auto-present.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Web App ─────────────────────────────────────────
# Public URL of the frontend (used for OAuth redirects).
WEB_APP_URL=http://localhost:5173

# ── Admin ───────────────────────────────────────────
INITIAL_ADMIN_EMAIL=admin@example.com

# ── Google OAuth ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production: https://api.auto-present.com/api/v1/auth/google/callback
GOOGLE_IDENTITY_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
GOOGLE_WORKSPACE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# ── JWT ─────────────────────────────────────────────
JWT_ISSUER=auto-present-api
JWT_AUDIENCE=auto-present-web
JWT_ACCESS_SECRET=
JWT_KEY_ID=v1
ACCESS_TOKEN_TTL=600
REFRESH_TOKEN_TTL=2592000

# ── Cookies ────────────────────────────────────────
# Set COOKIE_DOMAIN when frontend and API share a parent domain (e.g. .auto-present.com).
COOKIE_DOMAIN=
# Must be true in production. Enables Secure flag on cookies.
COOKIE_SECURE=false
# Set to 'none' when frontend and API are on different registrable domains.
# Requires COOKIE_SECURE=true. Default: lax
COOKIE_SAMESITE=lax

# ── Encryption ─────────────────────────────────────
# 32-byte (44-char base64) key for Google token encryption at rest.
#   Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_TOKEN_ENCRYPTION_KEY_VERSION=v1
# 32+ char secret for IP-address hashing (HMAC-SHA256).
IP_HASH_SECRET=

# ── Frontend Build Vars (VITE_) ─────────────────────
# These are embedded at build time. Set during frontend build/deploy.
# VITE_API_BASE_URL=https://api.auto-present.com/api/v1
# VITE_LOGIN_HELP_VIDEO_URL=
# VITE_SUPPORT_EMAIL=
# VITE_REPORT_PROBLEM_URL=
# VITE_GITHUB_URL=
# VITE_FACEBOOK_URL=
# VITE_YOUTUBE_URL=
# VITE_LINKEDIN_URL=
