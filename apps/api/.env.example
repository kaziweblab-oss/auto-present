# ── Runtime ──────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ── MongoDB ─────────────────────────────────────────
# Required in production. Local default: mongodb://127.0.0.1:27017/auto-present
MONGODB_URI=mongodb://127.0.0.1:27017/auto-present

# ── CORS ────────────────────────────────────────────
# Comma-separated origins allowed to access the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Web ─────────────────────────────────────────────
WEB_APP_URL=http://localhost:5173
TRUST_PROXY=false

# ── Admin ───────────────────────────────────────────
INITIAL_ADMIN_EMAIL=admin@example.com

# ── Google OAuth ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_IDENTITY_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
GOOGLE_WORKSPACE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# ── JWT ─────────────────────────────────────────────
JWT_ISSUER=auto-present-api
JWT_AUDIENCE=auto-present-web
JWT_ACCESS_SECRET=
JWT_KEY_ID=v1
ACCESS_TOKEN_TTL=600
REFRESH_TOKEN_TTL=2592000

# ── Cookies ────────────────────────────────────────
COOKIE_DOMAIN=
COOKIE_SECURE=false
# Set to 'none' when frontend and API are on different registrable domains. Requires COOKIE_SECURE=true.
COOKIE_SAMESITE=lax

# ── Encryption ─────────────────────────────────────
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_TOKEN_ENCRYPTION_KEY_VERSION=v1
IP_HASH_SECRET=
