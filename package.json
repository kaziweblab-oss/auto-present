{
  "name": "auto-present",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/shared",
    "packages/config",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace @auto-present/api",
    "dev:web": "npm run dev --workspace @auto-present/web",
    "start": "npm run start --workspace @auto-present/api",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace @auto-present/shared && npm run build --workspace @auto-present/config && npm run build --workspace @auto-present/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace @auto-present/api",
    "test:api": "npm run test:unit --workspace @auto-present/api && npm run test:esm --workspace @auto-present/api",
    "test:web": "npm run test:unit --workspace @auto-present/web",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0"
  }
}
